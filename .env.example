# Copy to .env and fill in. No secret ever lives in the code.
#
# The application REFUSES TO START on the placeholder secret key, because the
# facilitator flag lives in the signed session cookie: with the published key,
# anyone could forge a facilitator session and close every mission mid-exercise.

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECCAP_SECRET_KEY=change-me-long-random-string

# Set this with:  python scripts/set_facilitator_password.py
#
# NOT with a one-liner that puts the password on the command line. The shell
# rewrites the string before Python sees it — PowerShell expands $name and eats
# backticks, POSIX shells expand $name and ${name} and eat backslashes, cmd.exe
# expands %NAME%. The hash then belongs to a string nobody ever typed and the
# real password is refused forever. `--verify` diagnoses that case by name.
#
# EMPTY DISABLES facilitator access entirely. It does not mean "no password
# needed": an unset password is a refusal, never an open door.
SECCAP_FACILITATOR_PASSWORD_HASH=

# The teaching assistants' password — a second, weaker role. Set it with:
#   python scripts/set_facilitator_password.py --assistant
#
# A TA signs in at /assistant, picks the team whose table they are at, and sees
# what that team has written, which sources it has, and can hand it the next
# hint. Nothing else: no mission control, no session switches, no grading, no
# answer key. Separate from the facilitator password on purpose — five TAs
# holding the console password would be five people who can close a mission
# for the whole room by mistake. EMPTY DISABLES the role.
SECCAP_ASSISTANT_PASSWORD_HASH=

# SQLite, persisted in a mounted volume in the container.
SECCAP_DATABASE_URI=sqlite:////data/seccap.db

# Set to 1 when the app sits behind an HTTPS reverse proxy. Leave EMPTY for the
# classroom-network fallback, where the laptop serves plain http and a Secure
# cookie would never be sent.
SECCAP_COOKIE_SECURE=

# How many reverse proxies sit in front of this instance. EMPTY or 0 means
# X-Forwarded-For is IGNORED COMPLETELY, which is the right answer on the
# classroom laptop: with no proxy in front, a forged header would be the only
# thing the join limiter sees, and anyone could give themselves a fresh quota
# per request.
#
# On a hosted instance the opposite failure applies and this MUST be set. Every
# request then arrives from the proxy, and all twenty-five students land in one
# bucket of SECCAP_JOIN_RPM per minute — during the five minutes when the whole
# room is joining. Note that setting this correctly does NOT help when the room
# genuinely shares one public address behind a campus NAT: the client address
# is then the same for everyone, which is why SECCAP_JOIN_RPM defaults to 60.
#
# Count the hops the request actually passes through, and set exactly that:
#   1  Nginx or Caddy on the same host
#   2  Cloudflare in front of Nginx
# Setting it higher than the truth lets a caller forge the entries above the
# real ones, which is the same as trusting the header outright.
SECCAP_TRUSTED_PROXIES=

# Participant-facing default. "ja" for the event. "en" only for a rehearsal
# read-through with a non-Japanese-speaking reviewer.
SECCAP_DEFAULT_LANG=ja

# --- Tuning. Every one of these has a working default; set them only to change
# --- it. Listed so they are discoverable rather than buried in app/config.py.

# How often participant pages poll team state and the scoreboard.
SECCAP_POLL_SECONDS=5
# How often `last_seen` is actually written. NOT every poll: twenty-five
# browsers at a five-second interval would otherwise make presence the largest
# source of writes in the application, for a field nothing is scored on.
# Forced to at least two poll intervals — below that the throttle does nothing.
SECCAP_PRESENCE_SECONDS=15
# Answer submissions per team per minute, and join attempts per address.
#
# JOIN_RPM is SIXTY because a class is twenty-five and they arrive together. A
# rehearsal with the room on one egress address let nineteen in and refused the
# rest. Raise it further only if a class is larger; do not remove the limit,
# which is what stops somebody working through team codes.
SECCAP_SUBMIT_RPM=30
SECCAP_JOIN_RPM=60
# Longest free-text field a participant can save.
SECCAP_MAX_TEXT=2000

# Development only: auto-reload and Werkzeug's in-browser Python console.
# Leave EMPTY for any session with participants in front of the screens.
SECCAP_DEBUG=

# Development only: adds /admin, which signs any browser in as facilitator with
# NO PASSWORD and gives it one-click control of missions, seats and switches.
# It is there to walk the platform without running the exercise.
#
# Its own switch, separate from SECCAP_DEBUG, because it is a different risk:
# leaving the reloader on is untidy, leaving this on is handing the console to
# the room. EMPTY means /admin is a plain 404 and the code is never loaded.
# MUST be empty for the event and for any host reachable from outside the room.
SECCAP_ADMIN_BYPASS=
SECCAP_HOST=0.0.0.0
PORT=8000
